# Copy to .env (never commit it), fill in, then load it:
#   bash:        set -a && . ./.env && set +a
#   PowerShell:  Get-Content .env | Where-Object { $_ -match '^[A-Z_]+=' } | ForEach-Object { $k, $v = $_ -split '=', 2; Set-Item "env:$k" $v }

# Kalshi — kalshi.com → Account & security → API Keys
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/kalshi-key.pem

# Polymarket US — polymarket.us/developer → Create API key (the secret is shown once)
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=

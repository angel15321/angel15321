# Copy to .env (never commit it), fill in, then:  set -a && . ./.env && set +a

# Kalshi — kalshi.com → Account & security → API Keys
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=~/kalshi-key.pem

# Polymarket — polymarket.com → Settings → API Keys → Relayer API Keys
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET_ADDRESS=
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
